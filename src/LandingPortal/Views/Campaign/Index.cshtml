@model TaxpayerAnalytics.LandingPortal.Models.LandingPageViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>IRIS 2.0 Landing Page</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
  <div class="landing-wrapper">
    <header class="site-header">
      <div class="header-inner">
        <a href="#" class="iris-logo" aria-label="IRIS 2.0">
          <img class="iris-logo-img" src="/images/iris-logo.png">
        </a>

        <nav class="main-nav" aria-label="Main navigation">
          <a href="#home">Home</a>
          <a href="#about">About</a>
          <a href="#video">Video</a>
          <a href="#register">Register Now</a>
          <a href="#login" class="btn-login">Login to IRIS</a>
        </nav>

        <div class="fbr-logo" aria-label="FBR logo">
          <img src="/images/fbr-logo.png" />
        </div>
      </div>
    </header>

    <section class="hero-section" id="home">
      <div class="hero-content">
        <h1 class="hero-title">
          Compliance is <span class="gnr-txt">Simple. <img class="grn-ln" src="/images/grn-lne.png" /></span><br>
          Non-Compliance is <span class="hero-highlight"> Costly <img class="ylw-ln" src="/images/ylw-lne.png" /></span>.
        </h1>
        <p class="hero-subtitle">
          It takes just 10 minutes to file your taxes. No paperwork, no queues, no hassle.
        </p>
      </div>
    </section>

    <section class="steps-section" id="about">
      <div class="container">
        <div class="section-kicker">Getting Registered</div>
        <h2 class="section-title">HOW EASY IT IS</h2>
        <div class="step-facts">
          <span><img class="stp-sm-icn" src="/images/clock.png" /> 5 Minutes</span>
          <span><img class="stp-sm-icn" src="/images/online.png" /> Fully Online</span>
          <span><img class="stp-sm-icn" src="/images/document.png" /> No Documents Needed</span>
        </div>

        <div class="steps-line-wrap">
          <div class="step-card">
            <div class="step-icon blue"><img class="step-icon-sz" src="/images/cinic.png"></div>
            <div class="step-number">Step 01</div>
            <h3 class="step-title">Enter Your CNIC</h3>
            <p class="step-desc">Start with basic information, no documents needed.</p>
          </div>

          <div class="step-card">
            <div class="step-icon yellow"><img class="step-icon-ver" src="/images/verify.png"></div>
            <div class="step-number">Step 02</div>
            <h3 class="step-title">Verify &amp; Complete</h3>
            <p class="step-desc">A guided process that walks you through everything.</p>
          </div>

          <div class="step-card">
            <div class="step-icon green"><i class="bi bi-check-lg"></i></div>
            <div class="step-number">Step 03</div>
            <h3 class="step-title">You’re Done</h3>
            <p class="step-desc">Congratulations! Your NTN is generated instantly.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="video-section" id="video">
      <div class="container video-container">
        <div class="row align-items-center">
          <div class="col-lg-8">
            <div class="video-caption">How to Register on IRIS</div>
            <h2 class="video-title">Watch How Easy It Is <span>(2 Minutes)</span></h2>

            <div class="video-box">
              <div class="ratio ratio-16x9">
                <video controls data-tptrack="video" preload="metadata" playsinline>
                  <source src="@(Model.VideoUrl ?? "/videos/video1.mp4")" type="video/mp4">
                </video>
              </div>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="poster-card mt-3">
              <img class="poster-card-img" src="/images/tax-img.png" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section" id="register">
      <div class="container">
        <div class="section-kicker">Register Now</div>
        <h2 class="cta-title">TAKE THE FIRST STEP TODAY</h2>
        <p class="cta-subtitle">Begin with a few simple steps, everything is guided and easy to complete.</p>

        <div class="row justify-content-center g-5">
          <div class="col-lg-4 col-md-6">
            <a href="/c/redirect?t=@Model.Token&target=register" data-tptrack-cta="register" class="action-card green text-decoration-none">
              <span class="action-tag">3–5 minutes only</span>
              <span class="action-icon"><img class="ntn-img" src="/images/ntn.png"></span>
              <span class="mt-3">
                <span class="action-title d-block">Get Your NTN</span>
                <span class="action-meta d-block"><i class="bi bi-card-text me-1"></i> Requires CNIC</span>
                <span class="action-link">Start Registration <i class="bi bi-arrow-right"></i></span>
              </span>
            </a>
          </div>

          <div class="col-lg-4 col-md-6">
            <a href="/c/redirect?t=@Model.Token&target=file" data-tptrack-cta="file" class="action-card blue text-decoration-none">
              <span class="action-tag">Beginner-friendly</span>
              <span class="action-icon"><i class="bi bi-file-earmark-text"></i></span>
              <span class="mt-3">
                <span class="action-title d-block">File Your Return Now</span>
                <span class="action-meta d-block"><i class="bi bi-shield me-1"></i> Requires NTN / Login</span>
                <span class="action-link">Start Filing <i class="bi bi-arrow-right"></i></span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-logos">
          <span class="fbr-logo"><img class="fbr-logo-sm" src="/images/fbr-logo.png" /></span>
          <span class="iris-logo"><img class="iris-logo-sm" src="/images/iris-logo.png" /></span>
        </div>
        <p class="footer-text">
          This is an official communication from the <b>Federal Board of Revenue (FBR)</b>,<br>
          Government of Pakistan.
        </p>
        <div class="trust-badges">
          <span class="trust-badge"><i class="bi bi-lock lck-clr"></i> SSL Secure</span>
          <span class="trust-badge"><i class="bi bi-shield-check shld-clr"></i> Government Cloud</span>
          <span class="trust-badge"><i class="bi bi-globe globe-clr"></i> iris.fbr.gov.pk</span>
        </div>
        <div class="copyright">© 2026 Federal Board of Revenue, Government of Pakistan. All rights reserved.</div>
      </div>
    </footer>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  @await Html.PartialAsync("_TrackingScripts", Model)
</body>

</html>
