@model TaxpayerAnalytics.Shared.Dtos.CampaignOverviewDto
@{
    Layout = "_Layout";
    ViewData["Title"] = $"{Model.CampaignCode} · Campaign";
    var tpl = Model.PageTemplate?.ToLower() ?? "index";

    string TemplateIcon(string t) => t switch
    {
        "Index" => "bi-info-circle-fill",
        "Enforcement" => "bi-shield-fill-exclamation",
        "Combined" => "bi-layers-fill",
        "CivicDuty" => "bi-flag-fill",
        _ => "bi-megaphone-fill"
    };

    var tiles = new (string Label, string Value, string Class, string Icon)[]
    {
        ("Recipients",   Model.TotalRecipients.ToString("N0"),    "t-blue",   "bi-envelope-paper"),
        ("SMS Sent",     Model.TotalSmsSent.ToString("N0"),       "t-blue",   "bi-send"),
        ("Visits",       Model.TotalVisits.ToString("N0"),        "t-purple", "bi-eye"),
        ("Unique",       Model.UniqueVisitors.ToString("N0"),     "t-purple", "bi-people"),
        ("CTR",          $"{Model.ClickThroughRatePct:F2}%",      "t-pink",   "bi-graph-up-arrow"),
        ("Avg Duration", $"{Model.AvgSessionDurationSec:F1}s",    "t-green",  "bi-stopwatch"),
        ("Avg Scroll",   $"{Model.AvgScrollDepthPct:F1}%",        "t-green",  "bi-arrows-vertical"),
        ("Bounce",       $"{Model.BounceRatePct:F2}%",            "t-orange", "bi-arrow-bar-up"),
        ("Register",     Model.RegisterClicks.ToString("N0"),     "t-green",  "bi-person-plus"),
        ("File",         Model.FileClicks.ToString("N0"),         "t-blue",   "bi-file-earmark-text"),
        ("Video Start",  Model.VideoStarts.ToString("N0"),        "t-pink",   "bi-play-circle"),
        ("Video Done",   Model.VideoCompletions.ToString("N0"),   "t-pink",   "bi-check-circle")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 fade-in">
    <div>
        <a href="/dashboard" class="text-decoration-none small text-secondary"><i class="bi bi-arrow-left me-1"></i>Overview</a>
        <h3 class="mb-0 mt-1 fw-bold tpl-@tpl">
            <i class="bi @TemplateIcon(Model.PageTemplate) me-2"></i>
            <span class="gradient-text">@Model.CampaignCode</span>
            <span class="text-secondary fs-6 ms-2">@Model.Name</span>
        </h3>
    </div>
    <div class="text-end">
        <div class="big-num text-success" id="activeNow" data-count-up>@Model.ActiveUsersNow</div>
        <div class="big-num-sub">active now <span class="pulse-dot ms-1"></span></div>
    </div>
</div>

<div class="stat-strip fade-in d1">
    @foreach (var t in tiles)
    {
        <div class="stat-tile @t.Class">
            <i class="bi @t.Icon stat-icon"></i>
            <div class="stat-label">@t.Label</div>
            <div class="stat-value" data-count-up>@t.Value</div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-lg-8 fade-in d2">
        <div class="dash-card h-100"><div class="card-body p-4">
            <h6 class="mb-3"><i class="bi bi-graph-up me-1"></i>Visits over time</h6>
            <canvas id="visitsChart" height="90"></canvas>
        </div></div>
    </div>
    <div class="col-lg-4 fade-in d3">
        <div class="dash-card h-100"><div class="card-body p-4">
            <h6 class="mb-3"><i class="bi bi-pie-chart me-1"></i>Device Breakdown</h6>
            <canvas id="deviceChart" height="180"></canvas>
        </div></div>
    </div>
    <div class="col-lg-6 fade-in d4">
        <div class="dash-card h-100"><div class="card-body p-4">
            <h6 class="mb-3"><i class="bi bi-globe me-1"></i>Top Geographies</h6>
            <table class="table table-sm mb-0" id="geoTable">
                <thead><tr><th>Country</th><th>City</th><th class="text-end">Sessions</th></tr></thead>
                <tbody></tbody>
            </table>
        </div></div>
    </div>
    <div class="col-lg-6 fade-in d5">
        <div class="dash-card h-100"><div class="card-body p-4">
            <h6 class="mb-3"><i class="bi bi-broadcast me-1"></i>Live events on this campaign</h6>
            <div id="liveList" class="live-list"></div>
        </div></div>
    </div>
</div>

@section Scripts {
    <script>
        var campaignId = @Model.CampaignId;
        function fetchJson(u) { return fetch(u, { credentials: 'include' }).then(function (r) { return r.json(); }); }

        Promise.all([
            fetchJson('/api/dashboard/visits?campaignId=' + campaignId + '&bucket=hour'),
            fetchJson('/api/dashboard/devices?campaignId=' + campaignId),
            fetchJson('/api/dashboard/geo?campaignId=' + campaignId + '&top=15')
        ]).then(function (r) {
            DashCharts.renderVisits('visitsChart', r[0]);
            DashCharts.renderDevices('deviceChart', r[1]);
            DashCharts.renderGeo('geoTable', r[2]);
        });

        DashRealtime.start({ scope: 'campaign', campaignId: campaignId }, function (kind, payload) {
            if (kind === 'liveEvent') DashFeed.prepend('liveList', payload);
            if (kind === 'activeUsers' && payload.campaignId == campaignId) {
                document.getElementById('activeNow').textContent = payload.active;
            }
        });
    </script>
}
