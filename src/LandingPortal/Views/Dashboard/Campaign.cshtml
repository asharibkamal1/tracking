@model TaxpayerAnalytics.Shared.Dtos.CampaignOverviewDto
@{
    Layout = "_Layout";
    ViewData["Title"] = $"{Model.CampaignCode} · Campaign";
    var q = ViewBag.Query as TaxpayerAnalytics.Shared.Dtos.DashboardQuery;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <a href="/dashboard" class="text-decoration-none small text-secondary">&larr; Overview</a>
        <h4 class="mb-0 mt-1">@Model.CampaignCode <span class="text-secondary fs-6">@Model.Name</span></h4>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="big-num text-success" id="activeNow">@Model.ActiveUsersNow</span>
        <span class="text-secondary small">active now</span>
    </div>
</div>

<div class="row g-3 mb-4">
    @{
        var kpis = new (string Label, string Value)[]
        {
            ("Recipients",    Model.TotalRecipients.ToString("N0")),
            ("SMS Sent",      Model.TotalSmsSent.ToString("N0")),
            ("Visits",        Model.TotalVisits.ToString("N0")),
            ("Unique",        Model.UniqueVisitors.ToString("N0")),
            ("CTR",           $"{Model.ClickThroughRatePct:F2}%"),
            ("Avg Duration",  $"{Model.AvgSessionDurationSec:F1}s"),
            ("Avg Scroll",    $"{Model.AvgScrollDepthPct:F1}%"),
            ("Bounce",        $"{Model.BounceRatePct:F2}%"),
            ("Register",      Model.RegisterClicks.ToString("N0")),
            ("File",          Model.FileClicks.ToString("N0")),
            ("Video Start",   Model.VideoStarts.ToString("N0")),
            ("Video Done",    Model.VideoCompletions.ToString("N0"))
        };
    }
    @foreach (var k in kpis)
    {
        <div class="col-6 col-md-3 col-xl-2">
            <div class="card dash-card h-100"><div class="card-body p-3">
                <div class="text-secondary small">@k.Label</div>
                <div class="fs-4 fw-bold">@k.Value</div>
            </div></div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card dash-card"><div class="card-body">
            <h6 class="text-secondary">Visits over time</h6>
            <canvas id="visitsChart" height="90"></canvas>
        </div></div>
    </div>
    <div class="col-lg-4">
        <div class="card dash-card"><div class="card-body">
            <h6 class="text-secondary">Device Breakdown</h6>
            <canvas id="deviceChart" height="180"></canvas>
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card dash-card"><div class="card-body">
            <h6 class="text-secondary">Top Geographies</h6>
            <table class="table table-sm table-dark mb-0" id="geoTable">
                <thead><tr><th>Country</th><th>City</th><th class="text-end">Sessions</th></tr></thead>
                <tbody></tbody>
            </table>
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card dash-card"><div class="card-body">
            <h6 class="text-secondary mb-3">Live events on this campaign</h6>
            <div id="liveList" class="live-list"></div>
        </div></div>
    </div>
</div>

@section Scripts {
    <script>
        var campaignId = @Model.CampaignId;

        function fetchJson(u) { return fetch(u, { credentials: 'include' }).then(function (r) { return r.json(); }); }

        Promise.all([
            fetchJson('/api/dashboard/visits?campaignId=' + campaignId + '&bucket=hour'),
            fetchJson('/api/dashboard/devices?campaignId=' + campaignId),
            fetchJson('/api/dashboard/geo?campaignId=' + campaignId + '&top=15')
        ]).then(function (r) {
            DashCharts.renderVisits('visitsChart', r[0]);
            DashCharts.renderDevices('deviceChart', r[1]);
            DashCharts.renderGeo('geoTable', r[2]);
        });

        DashRealtime.start({ scope: 'campaign', campaignId: campaignId }, function (kind, payload) {
            if (kind === 'liveEvent') DashFeed.prepend('liveList', payload);
            if (kind === 'activeUsers' && payload.campaignId == campaignId) {
                document.getElementById('activeNow').textContent = payload.active;
            }
        });
    </script>
}
