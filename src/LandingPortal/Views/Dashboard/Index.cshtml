@model List<TaxpayerAnalytics.Shared.Dtos.CampaignOverviewDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Overview";
    var q = ViewBag.Query as TaxpayerAnalytics.Shared.Dtos.DashboardQuery;
    var qs = "";
    if (q is not null)
    {
        var parts = new List<string>();
        if (q.From.HasValue) parts.Add($"from={q.From.Value:yyyy-MM-dd}");
        if (q.To.HasValue) parts.Add($"to={q.To.Value:yyyy-MM-dd}");
        if (!q.ExcludeBots) parts.Add("excludeBots=false");
        qs = parts.Count == 0 ? "" : "?" + string.Join("&", parts);
    }

    string TemplateIcon(string t) => t switch
    {
        "Index" => "bi-info-circle-fill",
        "Enforcement" => "bi-shield-fill-exclamation",
        "Combined" => "bi-layers-fill",
        "CivicDuty" => "bi-flag-fill",
        _ => "bi-megaphone-fill"
    };

    var totalRecipients = Model.Sum(c => c.TotalRecipients);
    var totalVisits = Model.Sum(c => c.TotalVisits);
    var totalUnique = Model.Sum(c => c.UniqueVisitors);
    var totalRegister = Model.Sum(c => c.RegisterClicks);
    var totalFile = Model.Sum(c => c.FileClicks);
    var totalActive = Model.Sum(c => c.ActiveUsersNow);
    var blendedCtr = totalRecipients == 0 ? 0 : Math.Round(100.0 * totalUnique / Math.Max(1, totalRecipients), 2);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 fade-in">
    <div>
        <h3 class="mb-1 fw-bold">Campaign Overview</h3>
        <div class="text-secondary small">
            <span class="pulse-dot me-1"></span>Live · data refreshes automatically
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-success" href="/dashboard/export/excel@(qs)"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a class="btn btn-sm btn-outline-danger" href="/dashboard/export/pdf@(qs)"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
    </div>
</div>

<form method="get" class="row g-2 align-items-end mb-4 fade-in d1">
    <div class="col-auto">
        <label class="form-label small mb-1">From</label>
        <input type="date" class="form-control form-control-sm" name="From" value="@(q?.From?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-1">To</label>
        <input type="date" class="form-control form-control-sm" name="To" value="@(q?.To?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-auto form-check ms-2 mt-3">
        <input type="checkbox" class="form-check-input" id="botInc" name="ExcludeBots" value="false" @(q is not null && !q.ExcludeBots ? "checked" : "") />
        <label class="form-check-label small" for="botInc">Include bots</label>
    </div>
    <div class="col-auto"><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-funnel me-1"></i>Apply</button></div>
</form>

<div class="stat-strip fade-in d1" id="topStats">
    <div class="stat-tile t-green">
        <i class="bi bi-activity stat-icon"></i>
        <div class="stat-label">Active Now <span class="pulse-dot ms-1"></span></div>
        <div class="stat-value" data-field="active" data-count-up>@totalActive</div>
    </div>
    <div class="stat-tile t-blue">
        <i class="bi bi-eye stat-icon"></i>
        <div class="stat-label">Total Visits</div>
        <div class="stat-value" data-field="visits" data-count-up>@totalVisits</div>
    </div>
    <div class="stat-tile t-purple">
        <i class="bi bi-people-fill stat-icon"></i>
        <div class="stat-label">Unique Visitors</div>
        <div class="stat-value" data-field="unique" data-count-up>@totalUnique</div>
    </div>
    <div class="stat-tile t-orange">
        <i class="bi bi-envelope-paper stat-icon"></i>
        <div class="stat-label">Recipients</div>
        <div class="stat-value" data-field="recipients" data-count-up>@totalRecipients</div>
    </div>
    <div class="stat-tile t-pink">
        <i class="bi bi-graph-up-arrow stat-icon"></i>
        <div class="stat-label">Blended CTR</div>
        <div class="stat-value" data-field="ctr" data-count-up>@blendedCtr.ToString("F2")%</div>
    </div>
    <div class="stat-tile t-blue">
        <i class="bi bi-hand-index-thumb-fill stat-icon"></i>
        <div class="stat-label">Total Clicks</div>
        <div class="stat-value" data-field="clicks" data-count-up>@(totalRegister + totalFile)</div>
    </div>
</div>

<div class="row g-3" id="campaignGrid">
    @{ int delay = 2; }
    @foreach (var c in Model)
    {
        var tpl = c.PageTemplate?.ToLower() ?? "index";
        <div class="col-12 col-md-6 col-xl-3 fade-in d@(Math.Min(delay++, 6))">
            <div class="dash-card campaign-card tpl-@tpl h-100" data-cid="@c.CampaignId">
                <div class="campaign-head d-flex align-items-start gap-3">
                    <div class="campaign-icon"><i class="bi @TemplateIcon(c.PageTemplate)"></i></div>
                    <div class="flex-grow-1">
                        <div class="campaign-code gradient-text">@c.CampaignCode</div>
                        <div class="campaign-name">@c.Name</div>
                    </div>
                </div>
                <div class="campaign-body">
                    <div class="d-flex align-items-baseline gap-2 mb-3">
                        <div class="big-num gradient-text" data-field="active" data-count-up>@c.ActiveUsersNow</div>
                        <div class="big-num-sub">active <span class="pulse-dot ms-1"></span></div>
                    </div>

                    <div class="kpi-grid">
                        <div class="kpi-cell"><span class="kpi-label">SMS</span><span class="kpi-value" data-field="sms" data-count-up>@c.TotalSmsSent</span></div>
                        <div class="kpi-cell"><span class="kpi-label">Visits</span><span class="kpi-value" data-field="visits" data-count-up>@c.TotalVisits</span></div>
                        <div class="kpi-cell"><span class="kpi-label">Unique</span><span class="kpi-value" data-field="unique" data-count-up>@c.UniqueVisitors</span></div>
                        <div class="kpi-cell"><span class="kpi-label">CTR</span><span class="kpi-value" data-field="ctr" data-count-up>@c.ClickThroughRatePct.ToString("F2")%</span></div>
                        <div class="kpi-cell"><span class="kpi-label">Avg Dur</span><span class="kpi-value" data-field="avgDur" data-count-up>@c.AvgSessionDurationSec.ToString("F1")s</span></div>
                        <div class="kpi-cell"><span class="kpi-label">Avg Scroll</span><span class="kpi-value" data-field="avgScroll" data-count-up>@c.AvgScrollDepthPct.ToString("F1")%</span></div>
                        <div class="kpi-cell"><span class="kpi-label">Register</span><span class="kpi-value" data-field="register" data-count-up>@c.RegisterClicks</span></div>
                        <div class="kpi-cell"><span class="kpi-label">File</span><span class="kpi-value" data-field="file" data-count-up>@c.FileClicks</span></div>
                        <div class="kpi-cell"><span class="kpi-label">Bounce</span><span class="kpi-value" data-field="bounce" data-count-up>@c.BounceRatePct.ToString("F2")%</span></div>
                        <div class="kpi-cell"><span class="kpi-label">Video</span><span class="kpi-value" data-field="video">@c.VideoCompletions/@c.VideoStarts</span></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2" style="border-top:1px solid var(--border);">
                        <a class="btn btn-sm btn-primary" href="/dashboard/campaign/@c.CampaignId">
                            <i class="bi bi-arrow-right-circle me-1"></i>Drill down
                        </a>
                        <span class="text-success small fw-semibold" data-field="liveBadge">
                            <span class="pulse-dot me-1"></span>@c.ActiveUsersNow live
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        var topStats = document.getElementById('topStats');

        DashLive.attach({
            url: '/api/dashboard/overview',
            hubScope: { scope: 'all' },
            intervalMs: 15000,
            onData: function (rows) {
                var sumActive = 0, sumVisits = 0, sumUnique = 0, sumRecipients = 0, sumClicks = 0;
                rows.forEach(function (c) {
                    sumActive     += c.activeUsersNow;
                    sumVisits     += c.totalVisits;
                    sumUnique     += c.uniqueVisitors;
                    sumRecipients += c.totalRecipients;
                    sumClicks     += c.registerClicks + c.fileClicks;

                    var card = document.querySelector('[data-cid="' + c.campaignId + '"]');
                    if (!card) return;
                    DashLive.setField(card, 'active',    c.activeUsersNow);
                    DashLive.setField(card, 'sms',       c.totalSmsSent);
                    DashLive.setField(card, 'visits',    c.totalVisits);
                    DashLive.setField(card, 'unique',    c.uniqueVisitors);
                    DashLive.setField(card, 'ctr',       c.clickThroughRatePct.toFixed(2) + '%');
                    DashLive.setField(card, 'avgDur',    c.avgSessionDurationSec.toFixed(1) + 's');
                    DashLive.setField(card, 'avgScroll', c.avgScrollDepthPct.toFixed(1) + '%');
                    DashLive.setField(card, 'register',  c.registerClicks);
                    DashLive.setField(card, 'file',      c.fileClicks);
                    DashLive.setField(card, 'bounce',    c.bounceRatePct.toFixed(2) + '%');
                    DashLive.setField(card, 'video',     c.videoCompletions + '/' + c.videoStarts);
                    var badge = card.querySelector('[data-field="liveBadge"]');
                    if (badge) badge.innerHTML = '<span class="pulse-dot me-1"></span>' + c.activeUsersNow + ' live';
                });
                var ctr = sumRecipients ? (100 * sumUnique / sumRecipients) : 0;
                DashLive.setField(topStats, 'active',     sumActive);
                DashLive.setField(topStats, 'visits',     sumVisits);
                DashLive.setField(topStats, 'unique',     sumUnique);
                DashLive.setField(topStats, 'recipients', sumRecipients);
                DashLive.setField(topStats, 'ctr',        ctr.toFixed(2) + '%');
                DashLive.setField(topStats, 'clicks',     sumClicks);
            },
            onActiveUsers: function (payload) {
                var card = document.querySelector('[data-cid="' + payload.campaignId + '"]');
                if (!card) return;
                DashLive.setField(card, 'active', payload.active);
                var badge = card.querySelector('[data-field="liveBadge"]');
                if (badge) badge.innerHTML = '<span class="pulse-dot me-1"></span>' + payload.active + ' live';
            }
        });
    </script>
}
