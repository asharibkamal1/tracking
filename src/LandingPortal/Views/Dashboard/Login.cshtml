@model TaxpayerAnalytics.LandingPortal.Models.Dashboard.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · Taxpayer Analytics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css" asp-append-version="true">
</head>
<body class="dash login-bg">
    <div class="login-card-wrap">
        <div class="card login-card shadow-lg">
            <div class="card-body p-4 p-md-5">
                <h3 class="mb-1"><i class="bi bi-graph-up-arrow"></i> Taxpayer Analytics</h3>
                <p class="text-secondary small mb-4">Sign in to view dashboards</p>

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger py-2 small">@Model.Error</div>
                }

                <form method="post" action="/dashboard/login" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                    <div class="mb-3">
                        <label class="form-label small">Username</label>
                        <input class="form-control" name="Username" autofocus required maxlength="64" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Password</label>
                        <input class="form-control" name="Password" type="password" required maxlength="128" />
                    </div>

                    <button class="btn btn-primary w-100" type="submit">Sign in</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
