@model TaxpayerAnalytics.Shared.Dtos.TaxpayerDetailDto
@{
    Layout = "_Layout";
    ViewData["Title"] = $"NTN {Model.MaskedNtn}";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 fade-in">
    <div>
        <a href="/dashboard/taxpayers" class="text-decoration-none small text-secondary"><i class="bi bi-arrow-left me-1"></i>Taxpayers</a>
        <h3 class="mb-0 mt-1 fw-bold">
            <i class="bi bi-person-vcard me-2"></i>NTN <code>@Model.MaskedNtn</code>
            <span class="text-secondary fs-6 ms-2">@Model.CampaignCode · @Model.CampaignName</span>
        </h3>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-success" href="/dashboard/export/taxpayer/@Model.RecipientId/excel"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a class="btn btn-sm btn-outline-danger" href="/dashboard/export/taxpayer/@Model.RecipientId/pdf"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
    </div>
</div>

<div class="row g-3 mb-4 fade-in d1">
    <div class="col-md-4">
        <div class="dash-card h-100"><div class="card-body p-4">
            <h6 class="mb-3"><i class="bi bi-person-circle me-1"></i>Recipient</h6>
            <table class="table table-sm small mb-0 table-borderless">
                <tr><td class="text-secondary">Recipient Id</td><td class="text-end">@Model.RecipientId</td></tr>
                <tr><td class="text-secondary">Mobile</td><td class="text-end">@(Model.MobileMasked ?? "-")</td></tr>
                <tr><td class="text-secondary">Language</td><td class="text-end">@(Model.Language ?? "-")</td></tr>
                <tr><td class="text-secondary">Created</td><td class="text-end small">@Model.CreatedAt.ToString("u")</td></tr>
                <tr><td class="text-secondary">SMS Sent</td><td class="text-end small">@(Model.SmsSentAt?.ToString("u") ?? "-")</td></tr>
                <tr><td class="text-secondary">First Visit</td><td class="text-end small">@(Model.FirstVisitAt?.ToString("u") ?? "-")</td></tr>
                <tr><td class="text-secondary">Last Visit</td><td class="text-end small">@(Model.LastVisitAt?.ToString("u") ?? "-")</td></tr>
                <tr><td class="text-secondary">Visit Count</td><td class="text-end" data-count-up>@Model.VisitCount</td></tr>
                <tr><td class="text-secondary">Sessions</td><td class="text-end" data-count-up>@Model.Sessions.Count</td></tr>
            </table>
        </div></div>
    </div>
    <div class="col-md-8">
        <div class="dash-card h-100"><div class="card-body p-4">
            <h6 class="mb-3"><i class="bi bi-broadcast me-1"></i>Live activity</h6>
            <div id="liveList" class="live-list"></div>
        </div></div>
    </div>
</div>

<h5 class="mb-3 fw-bold fade-in d2"><i class="bi bi-clock-history me-2"></i>Session timeline</h5>

@if (Model.Sessions.Count == 0)
{
    <div class="alert alert-info">No sessions recorded yet for this taxpayer.</div>
}

@foreach (var s in Model.Sessions)
{
    <div class="dash-card mb-3 fade-in d3"><div class="card-body p-4">
        <div class="d-flex flex-wrap gap-3 align-items-center mb-2">
            <div>
                <div class="small text-secondary">Session</div>
                <code class="small">@s.SessionId</code>
            </div>
            <div>
                <div class="small text-secondary">Started</div>
                <div>@s.StartedAt.ToString("u")</div>
            </div>
            <div>
                <div class="small text-secondary">Ended</div>
                <div>@(s.EndedAt?.ToString("u") ?? "open")</div>
            </div>
            <div>
                <div class="small text-secondary">Browser / Device</div>
                <div>@s.Browser on @s.OperatingSystem (@s.DeviceType)</div>
            </div>
            <div>
                <div class="small text-secondary">Geo / IP</div>
                <div>@(s.City ?? "-"), @(s.Country ?? "-") · <code>@s.IpAddress</code></div>
            </div>
            <div class="ms-auto d-flex gap-2">
                @if (s.IsBot) { <span class="badge bg-warning text-dark">bot</span> }
                @if (s.IsBounce) { <span class="badge bg-secondary">bounce</span> } else { <span class="badge bg-info text-dark">interacted</span> }
                @if (s.IsEngaged) { <span class="badge bg-success">engaged</span> }
                @if (s.RegisterClicked) { <span class="badge bg-success">Register</span> }
                @if (s.FileClicked) { <span class="badge bg-primary">File</span> }
            </div>
        </div>

        <div class="d-flex flex-wrap gap-4 small text-secondary mb-3">
            <span>Duration: <span class="text-light">@s.DurationSeconds s</span></span>
            <span>Scroll: <span class="text-light">@s.MaxScrollDepth%</span></span>
            <span>Video: <span class="text-light">@s.VideoWatchSeconds s (@s.VideoWatchPercent%)</span></span>
            <span>TTI: <span class="text-light">@s.TimeToFirstInteractionMs ms</span></span>
            <span>Screen: <span class="text-light">@(s.ScreenResolution ?? "-")</span></span>
            <span>Referrer: <span class="text-light">@(s.Referrer ?? "-")</span></span>
        </div>

        <div class="timeline">
            @foreach (var e in s.Events)
            {
                <div class="timeline-row">
                    <div class="timeline-time">@e.EventTime.ToString("HH:mm:ss.fff")</div>
                    <div class="timeline-dot"></div>
                    <div class="timeline-text">
                        <span class="badge bg-dark border border-secondary">@e.EventTypeName</span>
                        @if (!string.IsNullOrEmpty(e.EventValue)) { <span class="ms-2">@e.EventValue</span> }
                        @if (e.ScrollDepth.HasValue) { <span class="text-secondary small">  scroll @e.ScrollDepth%</span> }
                        @if (e.DurationSeconds.HasValue) { <span class="text-secondary small">  @e.DurationSeconds s</span> }
                    </div>
                </div>
            }
            @if (s.Events.Count == 0)
            {
                <div class="text-secondary small">No events recorded for this session.</div>
            }
        </div>
    </div></div>
}

@section Scripts {
    <script>
        DashRealtime.start({ scope: 'recipient', recipientId: @Model.RecipientId }, function (kind, payload) {
            if (kind === 'liveEvent') DashFeed.prepend('liveList', payload);
        });
    </script>
}
