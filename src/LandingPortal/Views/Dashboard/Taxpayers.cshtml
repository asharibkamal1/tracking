@model TaxpayerAnalytics.Shared.Dtos.PagedResult<TaxpayerAnalytics.Shared.Dtos.TaxpayerRowDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Taxpayers";
    var q = ViewBag.Query as TaxpayerAnalytics.Shared.Dtos.DashboardQuery;
    var search = ViewBag.Search as string;
    var totalPages = (int)Math.Ceiling(Model.Total / (double)Model.PageSize);
}

<div class="d-flex justify-content-between align-items-center mb-3 fade-in">
    <h3 class="mb-0 fw-bold"><i class="bi bi-people-fill me-2"></i>Taxpayers</h3>
    <div class="text-secondary small">
        <span class="pulse-dot me-1"></span><span id="taxStatus">live</span> · <span id="taxTotal">@Model.Total</span> total · page @Model.Page
    </div>
</div>

<form method="get" class="row g-2 align-items-end mb-3 fade-in d1">
    <div class="col-md-4">
        <label class="form-label small mb-1">Search (masked NTN or mobile)</label>
        <input class="form-control form-control-sm" name="search" value="@search" placeholder="*****1-1" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-1">Page size</label>
        <select class="form-select form-select-sm" name="pageSize">
            @foreach (var n in new[] { 25, 50, 100, 200 })
            {
                <option value="@n" selected="@(Model.PageSize == n)">@n</option>
            }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-search me-1"></i>Search</button></div>
</form>

<div class="dash-card fade-in d1"><div class="card-body p-0">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Campaign</th>
                    <th>NTN</th>
                    <th>Mobile</th>
                    <th class="text-end">Visits</th>
                    <th class="text-end">Last seen</th>
                    <th class="text-end">Duration</th>
                    <th class="text-end">Scroll</th>
                    <th class="text-end">Video %</th>
                    <th>Clicks</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="taxBody"></tbody>
        </table>
    </div>
</div></div>

@if (totalPages > 1)
{
    <nav class="mt-3 fade-in d2"><ul class="pagination pagination-sm">
        @for (var p = 1; p <= totalPages; p++)
        {
            <li class="page-item @(p == Model.Page ? "active" : "")">
                <a class="page-link" href="?page=@p&pageSize=@Model.PageSize@(string.IsNullOrEmpty(search) ? "" : "&search=" + Uri.EscapeDataString(search))">@p</a>
            </li>
        }
    </ul></nav>
}

@section Scripts {
    <script>
        var page     = @Model.Page;
        var pageSize = @Model.PageSize;
        var search   = @Html.Raw(Json.Serialize(search ?? ""));
        var tbody    = document.getElementById('taxBody');
        var totalEl  = document.getElementById('taxTotal');

        function escapeHtml(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function rowHtml(r) {
            var chips = '';
            if (r.registerClicked) chips += '<span class="badge bg-success me-1">R</span>';
            if (r.fileClicked)     chips += '<span class="badge bg-primary me-1">F</span>';
            if (r.everBot)         chips += '<span class="badge bg-warning text-dark">bot</span>';
            return '<tr data-rid="' + r.recipientId + '">' +
                   '<td><span class="badge bg-secondary">' + escapeHtml(r.campaignCode) + '</span></td>' +
                   '<td><code>' + escapeHtml(r.maskedNtn) + '</code></td>' +
                   '<td><small class="text-secondary">' + escapeHtml(r.mobileMasked || '-') + '</small></td>' +
                   '<td class="text-end">' + r.visitCount + '</td>' +
                   '<td class="text-end small">' + (r.lastVisitAt ? new Date(r.lastVisitAt).toLocaleString() : '-') + '</td>' +
                   '<td class="text-end">' + r.totalDurationSec + ' s</td>' +
                   '<td class="text-end">' + r.maxScrollDepth + '%</td>' +
                   '<td class="text-end">' + r.videoWatchPercent + '%</td>' +
                   '<td>' + chips + '</td>' +
                   '<td class="text-end"><a class="btn btn-sm btn-outline-light" href="/dashboard/taxpayers/' + r.recipientId + '">View</a></td>' +
                 '</tr>';
        }

        function snapshot() {
            // Map data-rid -> JSON-ish blob so we can detect which rows changed.
            var out = {};
            tbody.querySelectorAll('tr[data-rid]').forEach(function (tr) {
                out[tr.dataset.rid] = tr.innerHTML;
            });
            return out;
        }

        DashLive.attach({
            url: '/api/dashboard/taxpayers?page=' + page + '&pageSize=' + pageSize +
                 (search ? '&search=' + encodeURIComponent(search) : ''),
            hubScope: { scope: 'all' },
            intervalMs: 15000,
            onData: function (paged) {
                if (!paged || !paged.rows) return;
                totalEl.textContent = paged.total;
                var prev = snapshot();
                tbody.innerHTML = paged.rows.map(rowHtml).join('') ||
                    '<tr><td colspan="10" class="text-center text-secondary py-4">No taxpayers match this filter.</td></tr>';
                // Flash rows whose contents actually changed.
                paged.rows.forEach(function (r) {
                    var tr = tbody.querySelector('tr[data-rid="' + r.recipientId + '"]');
                    if (!tr) return;
                    var before = prev[r.recipientId];
                    if (before && before !== tr.innerHTML) {
                        tr.classList.add('flash');
                        setTimeout(function () { tr.classList.remove('flash'); }, 1000);
                    }
                });
            }
        });
    </script>
}
