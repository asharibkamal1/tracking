@model IReadOnlyList<TaxpayerAnalytics.LandingPortal.Services.DummyRecipientInfo>
@{
    Layout = null;
    var pageMeta = new Dictionary<string, (string Color, string Description)>(StringComparer.OrdinalIgnoreCase)
    {
        ["Index"]       = ("#0d3b66", "General awareness — 3 steps, simple compliance."),
        ["Enforcement"] = ("#198754", "Enforcement notice — consequences of non-filing."),
        ["Combined"]    = ("#6f42c1", "Combined messaging — simple + costly."),
        ["CivicDuty"]   = ("#0d6efd", "Civic duty — your taxes build Pakistan.")
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background: #0b1220; color: #e2e8f0; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; min-height: 100vh; }
        .test-banner { background: linear-gradient(90deg, #f59e0b, #dc2626); color: #fff; font-weight: 600; letter-spacing: .5px; padding: 8px 0; text-align: center; }
        .card-launch { background: #1a2438; border: 1px solid #2a3a5a; color: #e2e8f0; border-radius: 12px; transition: transform .2s ease, box-shadow .2s ease; }
        .card-launch:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(0,0,0,.4); }
        .card-launch .pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .8px; }
        .token-box { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; background: #0b1220; border: 1px solid #2a3a5a; border-radius: 6px; padding: 8px 10px; color: #94a3b8; word-break: break-all; max-height: 56px; overflow: hidden; }
        .url-box { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; background: #0b1220; border: 1px solid #2a3a5a; border-radius: 6px; padding: 8px 10px; color: #cbd5e1; word-break: break-all; }
        h1 { font-weight: 700; letter-spacing: -0.5px; }
        h6 { color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; font-size: 12px; }
        pre.sql { background: #0b1220; border: 1px solid #2a3a5a; border-radius: 6px; padding: 12px 14px; color: #93c5fd; font-size: 12px; overflow-x: auto; }
        .step-num { display: inline-flex; width: 26px; height: 26px; border-radius: 50%; background: #2563eb; color: #fff; align-items: center; justify-content: center; font-weight: 700; margin-right: 8px; font-size: 13px; }
    </style>
</head>
<body>
    <div class="test-banner">
        <i class="bi bi-cone-striped"></i> TEST MODE &mdash; this launcher is gated by ASPNETCORE_ENVIRONMENT=Development or TestMode:Enabled=true
    </div>

    <div class="container py-5">
        <h1 class="mb-1">Taxpayer Analytics &mdash; Test Launcher</h1>
        <p class="text-secondary">Each card below is a real SMS link built from a dummy taxpayer record. Click <b>Open landing page</b> in a new tab; events will flow into <code>UserSession</code> and <code>EventLog</code> in SQL Server.</p>

        @if (Model.Count == 0)
        {
            <div class="alert alert-danger mt-4">
                No campaigns seeded. Run <code>db/schema.sql</code> against your <code>TaxpayerAnalytics</code> database, then refresh.
            </div>
        }

        <div class="row g-4 mt-2">
            @foreach (var link in Model)
            {
                var meta = pageMeta.TryGetValue(link.PageTemplate, out var m) ? m : (Color: "#475569", Description: "");
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="card card-launch h-100 p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="pill" style="background:@meta.Color;">@link.PageTemplate</span>
                            <span class="text-secondary small"><i class="bi bi-tag"></i> @link.CampaignCode</span>
                        </div>
                        <h4 class="mb-1">@link.CampaignName</h4>
                        <p class="text-secondary small mb-3">@meta.Description</p>

                        <h6 class="mb-1">Dummy NTN</h6>
                        <div class="mb-3"><code>@link.MaskedNtn</code></div>

                        <h6 class="mb-1 d-flex justify-content-between align-items-center">
                            <span>SMS landing URL</span>
                            <span class="badge @(link.SmsUrlLength <= 160 ? "bg-success" : "bg-danger")">@link.SmsUrlLength / 160 chars</span>
                        </h6>
                        <div class="url-box mb-3">@link.LandingUrl</div>

                        <h6 class="mb-1">Opaque token</h6>
                        <div class="token-box mb-3">@link.TrackingToken</div>

                        <div class="d-grid gap-2">
                            <a class="btn btn-primary btn-lg" href="@link.LandingUrl" target="_blank" rel="noopener">
                                <i class="bi bi-box-arrow-up-right"></i> Open landing page
                            </a>
                            <button class="btn btn-outline-light btn-sm" onclick="copyText(this, '@link.LandingUrl')">
                                <i class="bi bi-clipboard"></i> Copy URL
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <hr class="my-5 border-secondary" />

        <h3 class="mb-3">How to verify tracking works</h3>

        <div class="row g-4">
            <div class="col-lg-6">
                <h6><span class="step-num">1</span>Run both apps</h6>
                <pre class="sql">cd src
# terminal 1
dotnet run --project TrackingApi
# terminal 2
dotnet run --project LandingPortal</pre>
            </div>

            <div class="col-lg-6">
                <h6><span class="step-num">2</span>Open this page</h6>
                <pre class="sql">https://localhost:5001/
# or
https://localhost:5001/dev/test</pre>
            </div>

            <div class="col-lg-6">
                <h6><span class="step-num">3</span>Click into a landing page</h6>
                <p class="text-secondary small">Scroll the page, play the video, click <b>Get Your NTN</b> or <b>File Your Return Now</b>. The SDK will:</p>
                <ul class="text-secondary small">
                    <li>POST <code>/api/v1/session/start</code> on first load (creates a row in <code>UserSession</code>)</li>
                    <li>POST <code>/api/v1/events/batch</code> for scroll / video / clicks</li>
                    <li>POST <code>/api/v1/events/heartbeat</code> every 10 seconds while the page is visible</li>
                </ul>
            </div>

            <div class="col-lg-6">
                <h6><span class="step-num">4</span>Watch the TrackingApi console</h6>
                <p class="text-secondary small">You should see structured logs from <code>SessionController</code> and the per-request Serilog lines:</p>
                <pre class="sql">info: Session a3f1... started for recipient 1 campaign 1 bot=False
info: HTTP POST /api/v1/events/batch responded 200</pre>
            </div>

            <div class="col-12">
                <h6><span class="step-num">5</span>Inspect the database</h6>
                <pre class="sql">-- All sessions, newest first
SELECT TOP 20
    s.SessionId, s.CampaignId, s.RecipientId, s.IsBot, s.DurationSeconds,
    s.MaxScrollDepth, s.VideoWatchSeconds, s.RegisterClicked, s.FileClicked,
    s.Browser, s.OperatingSystem, s.DeviceType, s.IpAddress, s.StartedAt, s.LastHeartbeatAt
FROM dbo.UserSession s
ORDER BY s.StartedAt DESC;

-- Last 100 raw events
SELECT TOP 100
    e.EventTime, e.EventType, e.EventValue, e.DurationSeconds, e.ScrollDepth,
    e.PageUrl, e.SessionId
FROM dbo.EventLog e
ORDER BY e.EventTime DESC;

-- Per-campaign roll-up
SELECT
    c.CampaignCode,
    COUNT(*)                                AS Sessions,
    AVG(CAST(s.DurationSeconds AS FLOAT))   AS AvgDurationSec,
    AVG(CAST(s.MaxScrollDepth AS FLOAT))    AS AvgScrollPct,
    SUM(CASE WHEN s.RegisterClicked = 1 THEN 1 ELSE 0 END) AS RegisterClicks,
    SUM(CASE WHEN s.FileClicked = 1 THEN 1 ELSE 0 END)     AS FileClicks
FROM dbo.UserSession s
JOIN dbo.CampaignMaster c ON c.CampaignId = s.CampaignId
WHERE s.IsBot = 0
GROUP BY c.CampaignCode;</pre>
            </div>
        </div>

        <hr class="my-5 border-secondary" />
        <p class="text-secondary small mb-0">
            Want different dummy data? Edit the <code>Fixtures</code> array in
            <code>src/LandingPortal/Services/DummyDataSeeder.cs</code>.
            The seeder is idempotent — re-running it does not duplicate recipients.
        </p>
    </div>

    <script>
        function copyText(btn, text) {
            navigator.clipboard.writeText(text).then(function () {
                var orig = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg"></i> Copied!';
                btn.classList.add('btn-success');
                btn.classList.remove('btn-outline-light');
                setTimeout(function () {
                    btn.innerHTML = orig;
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-outline-light');
                }, 1500);
            });
        }
    </script>
</body>
</html>
