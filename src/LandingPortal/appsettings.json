{
  "ConnectionStrings": {
    "AnalyticsDb": "Server=(localdb)\\MSSQLLocalDB;Database=TaxpayerAnalytics;Encrypt=True;TrustServerCertificate=True;Integrated Security=True;MultipleActiveResultSets=True"
  },
  "Security": {
    "TokenEncryptionKey": "local-dev-token-encryption-key-replace-in-production",
    "PiiEncryptionKey": "local-dev-pii-encryption-key-replace-in-production",
    "NtnHashPepper": "local-dev-ntn-pepper-replace-in-production",
    "RateLimitPerMinute": 240,
    "SessionMaxIdleSeconds": 600,
    "SessionContinuationMinutes": 5
  },
  "GeoIp": {
    "Enabled": false,
    "DbPath": "C:\\ProgramData\\GeoIP\\GeoLite2-City.mmdb"
  },
  "Database": {
    "AutoApplySchema": true
  },
  "Dashboard": {
    "CookieLifetimeMinutes": 480,
    "Admin": {
      "Username": "admin",
      "Password": "admin"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
