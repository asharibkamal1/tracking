{
  "ConnectionStrings": {
    "AnalyticsDb": "Server=.;Database=TaxpayerAnalytics;Encrypt=True;TrustServerCertificate=True;Integrated Security=True;MultipleActiveResultSets=True"
  },
  "Security": {
    "TokenEncryptionKey": "REPLACE_WITH_32_BYTE_SECRET_FROM_KEY_VAULT",
    "PiiEncryptionKey": "REPLACE_WITH_32_BYTE_SECRET_FROM_KEY_VAULT",
    "NtnHashPepper": "REPLACE_WITH_RANDOM_PEPPER_FROM_KEY_VAULT",
    "RateLimitPerMinute": 120,
    "SessionMaxIdleSeconds": 600
  },
  "GeoIp": {
    "Enabled": false,
    "DbPath": "/var/lib/geoip/GeoLite2-City.mmdb"
  },
  "Cors": {
    "AllowedOrigins": "https://localhost:5001"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
